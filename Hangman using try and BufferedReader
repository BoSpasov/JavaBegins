                for (char c : randomWordZero) {
                    System.out.print(c + " ");
                }
                System.out.println();


                System.out.print("Enter a guess: ");
                char letter = scanner.next().toLowerCase().charAt(0);


                //Replaces all the underscores with the correct letter if it isn't already replaced.
                if (randomWord.indexOf(letter)>= 0) {



                   if(randomWordZero.contains(letter)) {


